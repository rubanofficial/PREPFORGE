# Backend Environment Variables
MONGODB_URI=mongodb://localhost:27017/prepforge
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# ===== REDIS / BULLMQ =====
# Required for BullMQ job queues (Queue + Worker connection)
#
# LOCAL DEVELOPMENT (Docker):
#   REDIS_URL=redis://localhost:6379
#
# PRODUCTION (Upstash — recommended):
#   Get from: console.upstash.com → your database → Details tab → Redis URL
#   IMPORTANT: Use rediss:// (double-s) to enable TLS — Upstash requires it
#   Format: rediss://default:<token>@<endpoint>.upstash.io:6379
#
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT.upstash.io:6379

# ===== GEMINI AI =====
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
