# ============================================================
# PrepForge Frontend — Environment Variables
# ============================================================
# Copy this file to .env for local development.
# NEVER commit .env with actual secrets or localhost values.
# ============================================================

# ── STRATEGY A: Explicit URL (recommended for production) ────────────────────
# Set both of these in the Vercel Dashboard:
#   Vercel → Project → Settings → Environment Variables
#
VITE_API_URL=https://prepforge-1-0mkx.onrender.com/api
VITE_SOCKET_URL=https://prepforge-1-0mkx.onrender.com

# ── STRATEGY B: Let vercel.json rewrites forward /api/* to Render ────────────
# Leave VITE_API_URL unset (commented out). apiClient.js falls back to '/api'.
# vercel.json already has a rewrite: /api/:path* → https://prepforge-1-0mkx.onrender.com/api/:path*
# NOTE: VITE_SOCKET_URL must still be set — rewrites don't help WebSocket connections.

# ── LOCAL DEVELOPMENT ─────────────────────────────────────────────────────────
# Do NOT set VITE_API_URL or VITE_SOCKET_URL.
# Vite proxy in vite.config.js forwards both /api and /socket.io → localhost:5000.
# VITE_API_URL=            ← intentionally blank in dev
# VITE_SOCKET_URL=         ← intentionally blank in dev
