# ============================================================
# PrepForge Frontend — Environment Variables
# ============================================================
# Copy this file to .env for local development.
# NEVER commit .env with actual secrets or localhost values.
# ============================================================

# ── STRATEGY A: Let vercel.json rewrites forward /api/* to Render ────────────
# Leave VITE_API_URL unset (commented out). apiClient.js falls back to '/api'.
# vercel.json already has a rewrite: /api/:path* → https://prepforge-29le.onrender.com/api/:path*
# This is the recommended approach — no Vercel env var needed for the API URL.

# ── STRATEGY B: Set explicit URL (useful for staging or debugging) ────────────
# Add this in the Vercel Dashboard → Project → Settings → Environment Variables:
# VITE_API_URL=https://prepforge-29le.onrender.com/api

# ── LOCAL DEVELOPMENT ─────────────────────────────────────────────────────────
# Do NOT set VITE_API_URL. Vite proxy in vite.config.js forwards /api → localhost:5000.
# VITE_API_URL=            ← intentionally blank

# ── SOCKET.IO ─────────────────────────────────────────────────────────────────
# DEV:  Leave blank. Vite proxy forwards /socket.io → localhost:5000 (ws: true).
# PROD: Add this in Vercel Dashboard → Project → Settings → Environment Variables:
#       VITE_SOCKET_URL=https://prepforge-29le.onrender.com
# VITE_SOCKET_URL=         ← intentionally blank in dev
